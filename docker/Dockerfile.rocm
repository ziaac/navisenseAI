# NaviSense AI brain service — ROCm image for AMD Radeon GPUs
FROM rocm/pytorch:rocm6.2_ubuntu22.04_py3.10_pytorch_release_2.3.0

WORKDIR /app

# System deps for audio + mujoco headless rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libgl1 libosmesa6 \
    && rm -rf /var/lib/apt/lists/*

COPY services/brain/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/brain/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# vLLM is run as a sibling process/container on the same GPU:
#   vllm serve Qwen/Qwen2.5-7B-Instruct --host 0.0.0.0 --port 8001
