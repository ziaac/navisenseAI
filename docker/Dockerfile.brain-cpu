# NaviSense AI brain service — CPU image for VPS demo (MOCK_MODE).
# MuJoCo + FastAPI run fine on CPU; Whisper/vLLM are skipped in mock mode.
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libosmesa6 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx websockets mujoco numpy
COPY services/brain/ .
ENV MOCK_MODE=1
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
